# Milvus（对应你本机启动的 milvus-etcd / milvus-minio / milvus 三个容器）
MILVUS_URI=http://localhost:19530
# 自建 Milvus 留空；Zilliz Cloud 等托管服务填 API Key
MILVUS_TOKEN=
# 命令行版使用的集合
COLLECTION_NAME=rag_demo
# Web 版使用的独立集合（带 department/doc_id 字段）
WEB_COLLECTION=rag_docs

# 首次启动时创建的账号（修改后需删除 data/app.db 才会重新生成）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
SEED_DEMO_USERS=true
DEMO_PASSWORD=demo123
# 登录失败限流：窗口内失败次数达到上限后锁定
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=600
LOGIN_LOCK_SECONDS=600
# 会话 Cookie 密钥；留空会自动生成并保存在 data/.secret_key
# SECRET_KEY=

# 切片参数
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=3
# 知识库检索：最高相似度低于该阈值时，视为“没有相关内容”
RAG_SCORE_THRESHOLD=0.35
# 没有相关内容时，是否让千问用通用知识回答（true/false）
RAG_FALLBACK_TO_LLM=true

# 混合检索：向量召回数、BM25 召回数、RRF 融合常数
HYBRID_DENSE_TOP_N=15
HYBRID_BM25_TOP_N=15
RRF_K=60
KEYWORD_COVERAGE_THRESHOLD=0.5

# Cross-Encoder 重排（模型从 ModelScope 下载到项目 models/ 下）
RERANK_ENABLED=true
RERANK_MODEL_PATH=./models/bge-reranker-base
RERANK_TOP_N=8
# 启动时后台预热向量/重排模型（第一次提问更快，占用约 300MB 内存）
WARMUP_ON_START=true

# 向量模型：fastembed（本地、免 Key、默认） / openai（任意 OpenAI 兼容接口） / hash（零依赖后备）
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 模型缓存目录（默认在系统临时目录，可能被清理；可指到项目内，路径按需修改）
# FASTEMBED_CACHE_PATH=./models/fastembed_cache
# 国内下载 HuggingFace 模型慢时，取消注释使用镜像
# HF_ENDPOINT=https://hf-mirror.com

# 如果用 OpenAI 兼容的 embedding 接口（例如 DashScope），取消下面注释：
# EMBEDDING_BACKEND=openai
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-xxx

# 大模型：Anthropic 兼容协议（阿里云百炼 Token Plan / 千问）
# ANTHROPIC_AUTH_TOKEN 有值时优先走这条链路；留空则使用下面的 OpenAI 兼容接口
LLM_MODEL=qwen3.8-max
LLM_MAX_TOKENS=4096
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic

# OpenAI 兼容接口（可选）。想用 DeepSeek 等时，把上面的 ANTHROPIC_AUTH_TOKEN 留空并取消注释：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxx
